{
    "cnn" : {

        "loss_function" : "binary_cross_entropy_loss",

        "hyperparameters" : {
            "batch_size" : 12,
            "reg_type" : "ridge",
            "reg_strength" : 1e-4,
            "kernel_size" : [3, 3],
            "stride" : 1,
            "padding" : 1,
            "pool_size" : [2, 2],
            "pool_stride" : [2, 2],
            "pool_type" : "max"
        },

        "sequences" : {

            "convolution" : {

                "pass_functions" : [
                    "conv2d", "relu", "pool"
                ],

                "layers" : [
                    {
                        "num_in_channels" : 3,
                        "num_out_features" : 64
                    },

                    {
                        "num_in_channels" : 64,
                        "num_out_features" : 128
                    },

                    {
                        "num_in_channels" : 128,
                        "num_out_features" : 256
                    },

                    {
                        "num_in_channels" : 256,
                        "num_out_features" : 512
                    }
                ]
            },

            "projection" : {

                "pass_functions" : [
                    "flatten", "linear_projection"
                ],

                "_comments" : [
                    "pre_embedding_size =",
                    "num_out_features * final pooled height * final pooled width",
                    "pre_embedding_size = 512 * (224 / 2 / 2 / 2 / 2) * (224 / 2 / 2 / 2 / 2",
                    "pre_embedding_size = 512 * 14 * 14 = 100352"
                ],

                "_comments_2" : [
                    "Layers with pass_functions as a parameter overrides the ",
                    "pass functions list above."
                ],

                "layers" : [
                    {
                        "pre_embedding_size" : 100352,
                        "embedding_size" : 768
                    },

                    {
                        "pass_functions" : ["linear_projection"],
                        "pre_embedding_size" : 768,
                        "embedding_size" : 80
                    }
                ]
            }
        }
    },

    "transformer" : {

        "loss_function" : "cross_entropy_loss",

        "hyperparameters" : {
            "reg_type" : "ridge",
            "reg_strength" : 1.5
        },

        "sequences" : {

            "embedding" : {
                
                "pass_functions" : [
                    "get_embedded_tokens"
                ],

                "layers" : [
                    {
                        "embedding_size" : 256
                    }
                ]
            },

            "encoding" : {

                "pass_functions" : [
                    "multi_head_attention",
                        "dropout", "residual_add", "layer_norm",
                    "feed_forward",
                        "dropout", "residual_add", "layer_norm"
                ],

                "layers" : [
                    {
                        "max_seq_len" : 12,
                        "num_attn_heads" : 4,
                        "embedding_size" : 256,
                        "feed_fwd_size" : 1024,
                        "dropout" : 0.1
                    },

                    {
                        "max_seq_len" : 12,
                        "num_attn_heads" : 4,
                        "embedding_size" : 256,
                        "feed_fwd_size" : 1024,
                        "dropout" : 0.1
                    },

                    {
                        "max_seq_len" : 12,
                        "num_attn_heads" : 4,
                        "embedding_size" : 256,
                        "feed_fwd_size" : 1024,
                        "dropout" : 0.1
                    }
                ]
            },

            "decoding" : {

                "pass_functions" : [
                    "multi_head_masked_self_attention",
                        "dropout", "residual_add", "layer_norm",
                    "multi_head_cross_attention",
                        "dropout", "residual_add", "layer_norm",
                    "feed_forward",
                        "dropout", "residual_add", "layer_norm"
                ],

                "layers" : [
                    {
                        "max_seq_len" : 12,
                        "num_attn_heads" : 4,
                        "embedding_size" : 256,
                        "feed_fwd_size" : 1024,
                        "dropout" : 0.1
                    },

                    {
                        "max_seq_len" : 12,
                        "num_attn_heads" : 4,
                        "embedding_size" : 256,
                        "feed_fwd_size" : 1024,
                        "dropout" : 0.1
                    },

                    {
                        "max_seq_len" : 12,
                        "num_attn_heads" : 4,
                        "embedding_size" : 256,
                        "feed_fwd_size" : 1024,
                        "dropout" : 0.1
                    }
                ]
            },

            "projection" : {
                
                "pass_functions" : [
                    "lin_proj"
                ],

                "layers" : [
                    {
                        "pre_embedding_size" : 256,
                        "embedding_size" : 512
                    }
                ]
            }
        }
    }
